  },
  "semanticPresentation": {
    "featuredItemsUseFaintBackground": true,
    "technologyCategoriesRequireExplicitClaims": true,
    "categoryPredicate": "technology.belongs_to_category"
  },
  "offline": {
    "remoteAssetsAllowed": false,
    "analyticsAllowed": false,
    "networkRequestsAllowed": false,
    "networkRequestsScope": "initial-and-unprompted-rendering",
    "unsolicitedNetworkRequestsAllowed": false,
    "optionalUserInitiatedVideo": {
      "allowedAfterExplicitPlay": true,
      "requiresOfflineLinkFallback": true,
      "requiresProviderDisclosure": true
    }
