    "measurementScopeRequired": ["subject", "quantity-or-range", "unit", "before-and-after-when-claimed", "timeframe-when-known", "attribution-status"],
    "separateMeasures": ["data-freshness", "database-query-latency", "user-visible-latency", "business-outcome"],
    "uncertainty": "show-plain-qualifier-near-claim-and-source-detail-in-evidence-lens",
    "graph": "relationships-only-never-an-implied-causal-diagram"
  },
  "entityReadout": {
    "selectedEntityOwnsTheSummary": true,
    "fallback": "identify-missing-specific-context-do-not-repeat-parent-summary",
    "organisation": ["what-the-organisation-or-product-is", "person-tenure-and-roles", "named-initiatives-with-their-own-context", "approved-organisation-context"],
    "role": ["mandate-and-scope", "period", "decisions-and-led-work", "linked-engagement"],
    "work": ["initiative-or-scenario", "product-or-problem", "person-contribution", "technical-approach", "reported-result", "supporting-evidence-and-contextual-technology"],
    "contribution": ["decision-or-action", "work-context", "result-or-limit"],
    "technology": ["specific-use", "work-context", "relationship-to-other-technologies"],
    "outcome": ["measured-subject", "result-and-units", "timeframe-and-attribution"],
    "interaction": "opening-a-linked-entity-recomputes-its-own-readout"
