  "entityExploration": {
    "ordinaryRowsOpenNavigator": false,
    "explicitExploreControl": true,
    "navigator": "wide-side-panel",
    "navigatorMaximumWidth": "720px",
    "graphFocusControlInNavigator": true
  },
  "graph": {
    "defaultView": "complete-authorised-relationship-graph-without-a-focus",
    "focusPicker": "searchable-multiselect-with-removable-selection-chips",
    "multipleFocusEffect": "highlight-union-of-selected-neighbourhoods-dim-but-do-not-hide-other-records",
    "nodeSelectionKeepsFocus": true,
    "navigation": ["pan", "zoom", "fit-or-reset", "full-screen-with-exit"],
    "selectionReadout": "single-selected-node-specific-context-remains-visible-in-graph-shell",
    "mobileReadout": "selected-node-bottom-drawer",
    "largeGraphReadability": "progressive-labels-and-neighbour-emphasis-with-every-node-still-available",
    "nodeSizing": "connection-count-relative-to-typical-degree-log-scaled-and-capped-at-1.65x-within-each-node-type",
    "click": "read-selected-node",
    "doubleClick": "explore",
    "contextMenu": "explore",
    "longPress": "explore",
    "keyboardActivation": "Enter-to-read-Shift-Enter-to-explore",
