    "localPrototypeUpdate": "reuse-existing-approved-shell",
    "localPrototypeCandidate": "prepare-non-replacing-canonical-candidate-on-person-request",
    "prototypeCandidate": "reviewed-packet-mapped-to-prototype-display-model-never-forged-validated-release",
    "candidateApproval": "requested-preview-may-be-created-locally-template-revision-approved-before-main-replacement",
