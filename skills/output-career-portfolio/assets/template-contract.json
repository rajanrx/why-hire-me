    "notInlineAfterMainContent": true,
    "minimumVisibleContent": "selected-entity-title-and-summary",
    "dismissal": ["visible-close", "Escape", "backdrop-or-swipe-when-accessible"],
    "focus": "enter-bottom-drawer-and-return-to-selected-record",
    "scroll": "drawer-content-internal-with-background-contained",
    "reducedMotion": true
