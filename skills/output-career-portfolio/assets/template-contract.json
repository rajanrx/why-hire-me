    "summaries": "short-entity-specific-copy-when-available",
    "groupByExplicitEngagement": true,
    "preserveUngroupedAchievements": true
  },
  "brandingAndNavigation": {
    "generatorAttribution": "visible-why-hire-me-name-and-official-github-link",
    "githubUrl": "https://github.com/rajanrx/why-hire-me",
    "contactNavigation": "only-when-approved-contact-target-is-present-and-working",
    "linkedin": "optional-local-icon-with-accessible-name-after-profile-url-consent",
    "remoteIconAssets": false
  },
  "evidencePresentation": {
    "achievementUnit": "one-distinct-work-contribution-or-outcome",
