{
  "schema": "why-hire-me.portfolio-template/v0.3",
  "templateFamily": "material-profile",
  "portfolioSchema": "why-hire-me.portfolio/v0.3",
  "rendererVersion": "1.0.0",
  "sources": {
    "html": "src/adapters/publication/material-career-portfolio-renderer.ts",
    "styles": "templates/career-portfolio/material-profile/styles.css",
    "script": "templates/career-portfolio/material-profile/app.js"
  },
  "theme": {
    "system": "material-3",
    "seed": "#6750a4",
    "default": "follow-system-colour-scheme",
    "override": "remembered-toggle-in-local-storage-with-system-fallback",
    "font": "roboto-flex-latin-variable-embedded-as-data-uri",
    "icons": "lucide-static-outline-inlined",
    "technologyIcons": "simple-icons-brand-mark-on-tinted-circle-category-glyph-fallback",
    "logos": "approved-organisation-logo-assets-initials-fallback"
  },
  "destinations": [
    "overview",
    "career",
    "skills",
    "explore",
    "records"
  ],
  "optionalDestinations": {
    "ask": "only-with-approved-ai-notebook-link-or-audio-overview"
  },
  "layout": {
    "expanded": "240px-navigation-drawer-collapsible-to-80px-rail",
