    "completeGraphAsInitialView": false,
    "evidenceLens": "records-destination-with-relationship-list"
  },
  "accessibility": [
    "wcag-2.2-aa-contrast-both-themes",
    "keyboard-complete",
    "focus-return-on-close",
    "reduced-motion",
    "graph-text-equivalent",
    "stable-url-fragments"
  ],
  "offline": {
    "networkRequestsAllowed": false,
    "networkRequestsScope": "initial-and-unprompted-rendering",
    "csp": "default-src-none-self-only-font-src-data-media-src-only-with-audio"
  },
  "print": "resume-with-all-included-records-honouring-resume-length",
  "brandingAndNavigation": {
    "generatorAttribution": "visible-why-hire-me-name-and-official-github-link",
    "githubUrl": "https://github.com/rajanrx/why-hire-me"
